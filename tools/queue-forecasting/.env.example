PULSE_USERNAME=
PULSE_PASSWORD=
PULSE_HOSTNAME=
PULSE_VHOST=
TASKCLUSTER_ROOT_URL=https://firefox-ci-tc.services.mozilla.com
TASKCLUSTER_CLIENT_ID=
TASKCLUSTER_ACCESS_TOKEN=
# Both are REQUIRED - docker-compose.yml fails to render without them, by
# design, so a service can never fall back to a password-less connection.
# POSTGRES_PASSWORD is the contents of ~/qf-secrets/postgres.pw.
# In DATABASE_URL the password must be URL-encoded (base64 contains + / =).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<url-encoded-password>@postgres:5432/forecasting

# Hostname the dashboard is served on; Caddy auto-issues/renews a Let's
# Encrypt cert for it. Must have an A/AAAA record pointing at this host.
DASHBOARD_DOMAIN=queue-forecasting.taskcluster.net

# test/smoke.js is destructive (unqualified DELETEs) and reads SMOKE_DATABASE_URL,
# never DATABASE_URL. It refuses port 5433, non-local hosts, and database names
# that are not marked disposable. Example:
# SMOKE_DATABASE_URL=postgresql://postgres@localhost:5544/forecasting_smoke

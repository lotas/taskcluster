[Unit]
Description=Socket for the queue-forecasting trusted evaluator
Documentation=file:///srv/queue-forecasting/tools/queue-forecasting/auto-research-phase2c-plan.md

[Socket]
ListenStream=/run/qf-eval/sock
Accept=no

# 0660 root:qfd, the same shape as qf-extract.socket and for the same three
# reasons -- qfd can connect, `research` cannot get as far as being refused, and
# `qfeval` does not need to be in qfd's group to own the socket.
#
# An earlier draft of the plan said 0600 root:qfeval, "so there is no group to be
# added to". That is wrong: 0600 grants the group nothing and qfd is not root, so
# it would have produced a channel the only permitted client could not open. The
# DAC layer is beneath the control, not the control: SO_PEERCRED is.
SocketUser=root
SocketGroup=qfd
SocketMode=0660

# 0755: TRAVERSABLE. 2a shipped 0750 on a runtime directory once and made the
# control plane unreachable, because chowning a socket does nothing about
# traversing the directory that holds it.
RuntimeDirectory=qf-eval
RuntimeDirectoryMode=0755

[Install]
WantedBy=sockets.target

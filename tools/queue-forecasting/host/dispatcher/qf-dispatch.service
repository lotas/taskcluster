[Unit]
Description=Queue-forecasting trusted experiment dispatcher
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=qfd
Group=qfd
# qfheavy is listed explicitly, not left to initgroups: qfd MUST be able to open
# the 0660 root:qfheavy lock inode for WRITE and to unlink a stale marker in the
# 2770 root:qfheavy intent directory. Both are startup preconditions, so a
# missing membership is a refusal to start rather than a silent loss of the
# mutex -- but naming it here means the unit states its own requirement.
SupplementaryGroups=docker qfrun qfclient qfheavy
ExecStart=/usr/bin/python3 /srv/queue-forecasting/tools/queue-forecasting/host/dispatcher/qfd.py
# `host/shared` on the path: `spec.normalize` delegates the `extract` kind to
# `shared/extract_spec.py`, which is the SAME module the extractor validates
# with. D16 requires both domains to agree, and two validators that agree by
# having been written twice do not agree for long.
#
# qfd stays stdlib-only (D6) -- `extract_spec` imports nothing outside the
# standard library, which is why it can live in `shared` at all.
Environment=PYTHONPATH=/srv/queue-forecasting/tools/queue-forecasting/host/shared
Environment=QFD_TRUSTED_DIR=/srv/queue-forecasting/tools/queue-forecasting/host/dispatcher
Environment=QFD_STATE_DIR=/var/lib/qf-platform
Environment=QFD_RUNS_DIR=/var/lib/qf-runs
Environment=QFD_REMOTE=https://github.com/lotas/qf-research
Environment=QFD_TOKEN_FILE=/etc/qf-dispatch/github-token
Environment=QFD_LOCK_FILE=/var/lib/qf-locks/heavy-training.lock
Environment=QFD_INTENT_DIR=/var/lib/qf-locks/intent.d
Environment=QFD_BUILD_LOCK=/var/lib/qf-platform/build.lock
Environment=QFD_BUILD_TIMEOUT_S=1800
Environment=QFD_BUILD_LOCK_WAIT_S=900
Environment=QFD_BUILD_SETTLE_S=30
Environment=QFD_JOB_HOLD_DEADLINE_S=9600
Environment=QFD_KILL_CONFIRM_S=300
Environment=QFD_STOP_TIMEOUT_S=10
# One QFD_SOCKET only. The plan's revision 12 text set it twice -- first
# /run/qf-dispatch/sock, then /run/qf-dispatch/client/sock -- and systemd keeps
# the last, so the first was dead but read as if it were the value.
Environment=QFD_SOCKET=/run/qf-dispatch/client/sock
Environment=QFD_ADMIN_SOCKET=/run/qf-dispatch/admin/sock
# The extractor's socket. qfd is a CLIENT of it and holds no database
# credential of its own (D15): it asks a service that holds one. The socket is
# 0660 root:qfd, so this membership is what lets the dispatcher connect --
# and `research`, which is in qfclient but not in qfd, cannot reach it at all.
Environment=QFD_EXTRACT_SOCKET=/run/qf-extract/sock
# Read-only, and ONLY to resolve a probe's `/extract` mount. `qf extracts` is
# relayed to the extractor rather than walked here, because that directory
# belongs to qfextract -- but mounting needs a path, so this is the one place the
# dispatcher has to know the layout. It never writes here.
Environment=QFD_EXTRACTS_DIR=/var/lib/qf-extracts
# The promoted baseline store. Read-only here too, and the ownership says why:
# the directory is root-owned and written only by promote-baseline.sh, run by a
# human on the deployment host. qfd resolves a baseline_hash to a path so it can
# mount it read-only at /baseline, and has no way to publish one.
Environment=QFD_BASELINES_DIR=/var/lib/qf-baselines
# Phase 2c. The contracts the evaluator judges by, in the trusted checkout and
# root-owned. qfd READS this only to turn a submitted contract hash into a
# legible refusal at submit time; the evaluator resolves it again and its answer
# is authoritative -- the same relationship as the settlement lag (D17). It is
# outside ReadWritePaths, so qfd cannot edit a rule it is judged by.
Environment=QFD_CONTRACTS_DIR=/srv/queue-forecasting/tools/queue-forecasting/host/contracts
Environment=QFD_EVAL_SOCKET=/run/qf-eval/sock
# Where the untrusted prediction set is staged for the evaluator (D28): qfd
# writes `<run_id>/in/`, the evaluator writes `<run_id>/out/` and nothing else.
# This one IS writable -- see ReadWritePaths below.
Environment=QFD_EVAL_DIR=/var/lib/qf-eval
# A SECOND copy of the settlement lag, and the duplication is deliberate (D17).
# The EXTRACTOR's value is authoritative and it validates every request again;
# this copy exists only so a request naming an unsettled window is refused at
# submit time with a legible message, instead of after the job has been queued,
# leased and relayed. If the two disagree the extractor wins -- which is
# fail-closed, since the extractor's is the stricter check by construction.
# Keep it equal to QFX_SETTLEMENT_LAG_S in qf-extract.service.
Environment=QFD_SETTLEMENT_LAG_S=172800
Environment=QFD_ADMIN_UID=%%DEPLOY_UID%%
Environment=QFD_REAP_INTERVAL_S=60
Environment=QFD_SETUP_TEARDOWN_ALLOWANCE_S=600
Environment=QFD_MARKER_STALE_MARGIN_S=900
Environment=QFD_LOCK_MIGRATED_MARKER=/etc/qf-dispatch/lock-migrated
Environment=QFD_ADMITTED_MEM_BUDGET_MB=22528
Environment=QFD_TIMEOUT_MAX_S=5400
Environment=QFD_LOCK_WAIT_S=11400
Environment=QFD_IMAGE_BUILD_MEM_MB=2048
Environment=QFD_LIGHT_WORKERS=2
Environment=QFD_LOG_CAP_MB=16
Environment=QFD_ARTIFACT_CAP_MB=2048
Environment=QFD_HANDOFF_TIMEOUT_S=120
Environment=QFD_DISK_FLOOR_GB=20
Environment=QFD_QUEUED_CAP_PER_UID=20
# The lease is much shorter than a job may run (TIMEOUT_MAX is 5400), so the
# runner renews at a third of it; without renewal the reclaimer eats live work.
Environment=QFD_LEASE_S=300
RuntimeDirectory=qf-dispatch qf-dispatch/client qf-dispatch/admin
# 0711 on the parent: TRAVERSABLE but not listable. Revision 9 had 0750 qfd:qfd,
# which made BOTH sockets unreachable -- research, deploy, qfclient and qfheavy
# alike -- because chowning a socket does not grant traversal of its directory.
# The whole control plane was unusable and nothing in the acceptance list would
# have caught it, since every check assumed a reachable socket.
RuntimeDirectoryMode=0711
StateDirectory=qf-platform qf-runs
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=no
PrivateDevices=yes
# NO, and this is a deliberate exception rather than an oversight.
# RestrictSUIDSGID installs a seccomp filter that fails ANY chmod carrying
# S_ISUID or S_ISGID with EPERM -- including the setgid bit on a directory,
# which Runner.prepare_run_dir needs on each run's out/. That bit is
# load-bearing: without it, files the sandbox writes take the creating process's
# group, and the handoff container (uid 10001, group qfrun) cannot read the
# artifacts it exists to collect. There is no directories-only variant of the
# restriction, so every run failed at its first chmod.
#
# The residual: qfd runs as the unprivileged qfd user, which can only set a
# setuid bit on a file it already owns -- so this buys an attacker who is
# ALREADY qfd a persistence trick, not an escalation. Against an artifact path
# that cannot work at all, that is the smaller cost. Revisit if the sandbox ever
# runs with qfrun as its primary gid, which would make the setgid bit redundant
# and let this come back.
RestrictSUIDSGID=no
# THE `-` ON qf-eval IS DELIBERATE. A path listed here that does not exist
# makes the unit fail to START, and /var/lib/qf-eval is provisioned by
# phase2c-setup.sh -- so without the prefix, installing 2c would have become a
# prerequisite for running 2a, which is the opposite of what the code says
# (`Dispatcher.qfeval_gid` is None on such a host and the staging step tolerates
# it). With the prefix a 2a-only host starts, and an `evaluate` job fails at the
# evaluator socket, which is where the absence of 2c belongs.
#
# A DIRECTORY CREATED AFTER THIS SERVICE STARTED IS NOT IN ITS NAMESPACE: the
# mount is set up once, at start. So phase2c-setup.sh restarts the dispatcher
# and then MEASURES writability from inside the running namespace rather than
# telling somebody to remember.
ReadWritePaths=/var/lib/qf-platform /var/lib/qf-runs /var/lib/qf-locks -/var/lib/qf-eval
# Leave nothing behind on a clean stop: an orphaned heavy container would keep
# 22g while its flock died with the process (design 4.2). Both roles carry
# qf.run_id, so this covers the handoff as well as the candidate.
ExecStopPost=/usr/bin/env bash -c 'docker ps -q --filter label=qf.run_id | xargs -r docker stop -t 10'
# PrivateTmp is off for defence in depth only: the lock now lives under
# /var/lib, so a private /tmp would not break it. It stays off because a future
# reader who moves the lock back to /tmp would otherwise get two private inodes
# and no mutex, silently -- which is what two 22g trainers on a ~29g host cost
# in 2026-07, twice.
#
# The real requirements are elsewhere and are checked at startup:
#   - ONE inode. flock is per inode, so `LOCK_FILE` must name the same file the
#     deploy user's cron entry names -- hence QFD_LOCK_MIGRATED_MARKER.
#   - Shared PERMISSION, not just a shared namespace: daily_walk_forward.sh:213
#     opens the lock for WRITE (`exec 9>`), so the inode is 0660 root:qfheavy.
#   - qfheavy contains qfd and the deploy user, NEVER research: qfclient does
#     contain research, which would let the agent hold the mutex indefinitely.
PrivateTmp=no
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

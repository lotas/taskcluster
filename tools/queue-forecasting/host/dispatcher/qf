#!/usr/bin/env python3
"""qf -- the client. One connection, one JSON line, one JSON line back.

Bulk data is never on the protocol (design D9): `qf logs` reads the file
directly, which keeps the socket small enough to audit and means inspecting a
900k-row prediction set is a file read rather than a stream the dispatcher has
to babysit.

`qfadmin` is this same script invoked under its other name; it talks to the
admin socket and carries only `force-release`. The split is the access-control
boundary, not a convenience: the client socket's group contains `research`.
"""
from __future__ import annotations

import argparse
import json
import re
import os
import socket
import sys
import time

CLIENT_SOCKET = os.environ.get("QF_SOCKET", "/run/qf-dispatch/client/sock")
ADMIN_SOCKET = os.environ.get("QF_ADMIN_SOCKET", "/run/qf-dispatch/admin/sock")
RUNS_DIR = os.environ.get("QF_RUNS_DIR", "/var/lib/qf-runs")
POLL_S = 5
TERMINAL = {"SUCCEEDED", "FAILED", "TIMEOUT", "CANCELLED", "REFUSED"}


def call(op, payload=None, *, admin=False, timeout=60):
    path = ADMIN_SOCKET if admin else CLIENT_SOCKET
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(path)
            s.sendall(json.dumps({"op": op, "payload": payload or {}}).encode()
                      + b"\n")
            buf = bytearray()
            while b"\n" not in buf:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf.extend(chunk)
    except FileNotFoundError:
        die(f"no dispatcher socket at {path}")
    except PermissionError:
        die(f"permission denied on {path};"
            f" {'qfheavy' if admin else 'qfclient'} membership is required")
    except (ConnectionRefusedError, socket.timeout) as e:
        die(f"cannot talk to {path}: {e}")
    if not buf:
        die("the dispatcher closed the connection without replying")
    return json.loads(bytes(buf).split(b"\n")[0])


def die(msg, code=2):
    print(f"qf: {msg}", file=sys.stderr)
    raise SystemExit(code)


def show(resp, as_json=False):
    if as_json:
        print(json.dumps(resp, indent=2, sort_keys=True))
        return
    if not resp.get("ok"):
        die(resp.get("error", "unknown error"))
    for key, value in sorted(resp.items()):
        if key == "ok":
            continue
        if isinstance(value, (dict, list)):
            print(f"{key}: {json.dumps(value, sort_keys=True)}")
        else:
            print(f"{key}: {value}")


def cmd_ping(args):
    resp = call("ping")
    if resp.get("ok") and resp.get("stall"):
        # Named loudly: a silent stall looks exactly like an idle dispatcher.
        print("STALLED:", resp["stall"]["detail"], file=sys.stderr)
    show(resp, args.json)


def cmd_submit(args):
    spec = {"schema": 1, "kind": args.kind, "source_sha": args.sha}
    argsd = {}
    if args.path:
        argsd["paths"] = args.path
    if args.k:
        argsd["k"] = args.k
    if args.flag:
        argsd["pytest_args"] = args.flag
    if argsd:
        spec["args"] = argsd
    for name, value in (("timeout_s", args.timeout), ("mem_limit", args.mem),
                        ("cpus", args.cpus), ("note", args.note)):
        if value is not None:
            spec[name] = value

    resp = call("submit", {"spec": spec})
    if not resp.get("ok"):
        die(resp.get("error", "submit refused"))
    run_id = resp["run_id"]
    print(run_id)
    if not args.wait:
        return
    # Poll to a terminal state and exit with the job's own code, so a script
    # gets a normal shell exit without a streaming protocol.
    while True:
        time.sleep(POLL_S)
        st = call("status", {"run_id": run_id})
        if not st.get("ok"):
            die(st.get("error", "status failed"))
        job = st["job"]
        if job["state"] in TERMINAL:
            print(f"{job['state']} exit_code={job['exit_code']}"
                  f" error_class={job['error_class']}", file=sys.stderr)
            code = job["exit_code"]
            raise SystemExit(code if isinstance(code, int) else 1)


def cmd_extract(args):
    """Ask for a frozen extract. Prints the run id; `--wait` polls to terminal.

    No `--sha`: an extraction runs no code, so a commit would record a
    dependency it does not have. Its identity is its REQUEST, which the
    dispatcher derives (see `spec.EXTRACT_SOURCE_REF`).
    """
    spec_body = {
        "schema": 1,
        "kind": "extract",
        "args": {
            "target": args.target,
            "train_start": args.train_start,
            "as_of_date": args.as_of,
            "lookback_days": args.lookback_days,
        },
    }
    if args.generation is not None:
        spec_body["args"]["generation"] = args.generation
    if args.note:
        spec_body["note"] = args.note

    resp = call("submit", {"spec": spec_body})
    if not resp.get("ok"):
        die(resp.get("error", "submit refused"))
    run_id = resp["run_id"]
    print(run_id)
    if not args.wait:
        return
    # POLLED, not held open. A real extraction took 688 seconds; a client that
    # blocked on one socket for that long would look hung, and the dispatcher's
    # job row is the thing that actually knows how it went.
    while True:
        time.sleep(POLL_S)
        st = call("status", {"run_id": run_id})
        if not st.get("ok"):
            die(st.get("error", "status failed"))
        job = st["job"]
        if job["state"] in TERMINAL:
            pins = job.get("pins") or {}
            print(f"{job['state']} error_class={job['error_class']}",
                  file=sys.stderr)
            for key in ("extract_hash", "extract_dir", "extract_watermark"):
                if pins.get(key):
                    print(f"{key}: {pins[key]}", file=sys.stderr)
            raise SystemExit(0 if job["state"] == "SUCCEEDED" else 1)


def _resolve_prefix(given, *, flag, op, key, listing, publisher):
    """A unique prefix becomes the full hash. Resolved IN THE CLIENT.

    ONE function for extracts and baselines, because it is one algorithm: the
    ergonomics belong here and the strictness belongs at the boundary. The
    dispatcher still receives 64 lowercase hex and still refuses anything else.

    Ambiguity is a refusal that PRINTS the candidates. Picking the first match
    would mean a two-character-shorter prefix silently reading different data --
    and for a baseline that is worse than for an extract, because a probe whose
    comparison shifted underneath it still produces plausible numbers.
    """
    if _HEX64_RE.match(given or ""):
        return given
    if not _PREFIX_RE.match(given or ""):
        die(f"{flag} {given!r} is neither a hash nor a prefix of one"
            f" (8-64 lowercase hex). `{listing}` lists what is published.")

    resp = call(op)
    if not resp.get("ok"):
        die(resp.get("error", f"cannot list {op} to resolve a prefix"))
    matches = sorted({row.get(key) for row in resp.get(op, [])
                      if (row.get(key) or "").startswith(given)})
    if not matches:
        die(f"nothing published starts with {given!r}."
            f" `{listing}` lists what is published; {publisher} publishes one.")
    if len(matches) > 1:
        lines = "\n  ".join(matches)
        die(f"{given!r} matches {len(matches)} published, so it is ambiguous."
            f" Use more characters:\n  {lines}")
    return matches[0]


def resolve_extract(given):
    """The extracts listing is RELAYED from the service that owns the directory,
    which is the same `extracts` op a human would run."""
    return _resolve_prefix(given, flag="--extract", op="extracts",
                           key="request_hash", listing="qf extracts",
                           publisher="`qf extract`")


def resolve_contract(given):
    """The contracts listing is read by the dispatcher from the trusted
    checkout, which is also where the evaluator reads it."""
    return _resolve_prefix(given, flag="--contract", op="contracts",
                           key="contract_hash", listing="qf contracts",
                           publisher="`instantiate-contract.sh`")


def resolve_baseline(given):
    """The baselines listing is read by the dispatcher: the store has no service
    of its own, and qfd already reads it to resolve a mount."""
    return _resolve_prefix(given, flag="--baseline", op="baselines",
                           key="baseline_hash", listing="qf baselines",
                           publisher="`promote-baseline.sh`")


def cmd_probe(args):
    """Run an agent-authored script against a published extract.

    Unlike `extract`, a probe DOES take a `--sha`: it runs code, so the record
    must say which code. The extract must ALREADY EXIST -- `qf extracts` lists
    what is published -- because a probe that triggered an eleven-minute
    extraction would put a surprise inside a job someone expected to be quick.
    """
    spec_body = {
        "schema": 1,
        "kind": "probe",
        "source_sha": args.sha,
        "args": {"path": args.path, "extract": resolve_extract(args.extract)},
    }
    # OPTIONAL. A non-residual cohort reads no baseline, and there is no
    # "latest": a comparison whose baseline was chosen for it cannot say what it
    # was measured against.
    if args.baseline:
        spec_body["args"]["baseline"] = resolve_baseline(args.baseline)
    for name, value in (("mem_limit", args.mem), ("cpus", args.cpus),
                        ("timeout_s", args.timeout), ("note", args.note)):
        if value is not None:
            spec_body[name] = value

    resp = call("submit", {"spec": spec_body})
    if not resp.get("ok"):
        die(resp.get("error", "submit refused"))
    run_id = resp["run_id"]
    print(run_id)
    if not args.wait:
        return
    while True:
        time.sleep(POLL_S)
        st = call("status", {"run_id": run_id})
        if not st.get("ok"):
            die(st.get("error", "status failed"))
        job = st["job"]
        if job["state"] in TERMINAL:
            print(f"{job['state']} exit_code={job['exit_code']}"
                  f" error_class={job['error_class']}", file=sys.stderr)
            pins = job.get("pins") or {}
            for key in ("extract_hash", "extract_dir"):
                if pins.get(key):
                    print(f"{key}: {pins[key]}", file=sys.stderr)
            code = job["exit_code"]
            raise SystemExit(code if isinstance(code, int) else 1)


def cmd_extracts(args):
    """What the extractor has published: identity, window and watermark.

    Relayed by the dispatcher from the extractor, which owns the directory.
    """
    resp = call("extracts")
    if args.json:
        show(resp, True)
        return
    if not resp.get("ok"):
        die(resp.get("error", "extracts failed"))
    rows = resp.get("extracts") or []
    if not rows:
        print("no published extracts")
        return
    for row in rows:
        watermark = row.get("watermark") or {}
        print(f"{(row.get('request_hash') or '?')[:12]}"
              f"  extract={(row.get('extract_hash') or '?')[:12]}"
              f"  {row.get('target')}"
              f"  {row.get('train_start')}..{row.get('as_of_date')}"
              f"  gen={row.get('generation')}")
        # THE FULL HASH, on its own line and labelled with the flag it goes to.
        # The short form above is for reading; this is for copying. Printing only
        # the truncated one -- with the full value buried inside `dir=` -- made the
        # natural copy-paste the value the validator refuses.
        print(f"    --extract {row.get('request_hash')}")
        print(f"    dir={row.get('dir')}")
        if watermark:
            print("    watermark=" + " ".join(
                f"{k}={v}" for k, v in sorted(watermark.items())))
        rows_by_file = row.get("rows") or {}
        if rows_by_file:
            print("    rows=" + " ".join(
                f"{k}={v}" for k, v in sorted(rows_by_file.items())))


def cmd_baselines(args):
    """What has been promoted: identity, day coverage and promotion time.

    Read by the dispatcher, not relayed: the baseline store has no service of its
    own, and qfd already reads it to resolve a probe's mount.
    """
    resp = call("baselines")
    if args.json:
        show(resp, True)
        return
    if not resp.get("ok"):
        die(resp.get("error", "baselines failed"))
    rows = resp.get("baselines") or []
    if not rows:
        print(f"no promoted baselines in {resp.get('store')}")
        return
    for row in rows:
        broken = row.get("broken")
        print(f"{(row.get('baseline_hash') or '?')[:12]}"
              f"  days={row.get('days')}"
              f"  rows={row.get('ndjson_rows')}"
              f"  {row.get('pending_at_min')}..{row.get('pending_at_max')}"
              f"  promoted={row.get('promoted_at') or 'unknown'}")
        # THE FULL HASH, on its own line and labelled with the flag it goes to --
        # the same reason as `qf extracts`: the short form is for reading, and
        # printing only that made the natural copy-paste the value the validator
        # refuses.
        print(f"    --baseline {row.get('baseline_hash')}")
        excluded = row.get("exclude_dates") or []
        if excluded:
            # DECLARED at promotion and not derivable from the files, so a
            # listing that hid it would present a choice as if it had none.
            print(f"    exclude_dates={','.join(excluded)}")
        if broken:
            # Reported, not omitted: a half-promoted directory has to be visible
            # to the command an operator runs to find out why a probe refused.
            print(f"    BROKEN: {broken}", file=sys.stderr)
    if resp.get("truncated"):
        print(f"  ({resp.get('published')} promoted; showing {len(rows)})",
              file=sys.stderr)


def cmd_contracts(args):
    """The rules the trusted checkout carries.

    A contract is named by HASH everywhere, so this is how a human gets one --
    the same shape as `qf extracts` and `qf baselines`, and for the same reason:
    printing only a truncated identity makes the natural copy-paste the value the
    validator refuses.
    """
    resp = call("contracts")
    if args.json:
        show(resp, True)
        return
    if not resp.get("ok"):
        die(resp.get("error", "contracts failed"))
    rows = resp.get("contracts") or []
    if not rows:
        print(f"no contracts in {resp.get('dir') or '<unset>'}")
        print("  (a .json.in template is not a contract: it carries no pinned")
        print("   baseline, so it judges against nothing. See")
        print("   instantiate-contract.sh)")
        return
    for row in rows:
        print(f"{(row.get('contract_hash') or '?')[:12]}  {row.get('file')}")
        print(f"    --contract {row.get('contract_hash')}")


def cmd_evaluate(args):
    """Judge a finished probe by a contract in the trusted checkout.

    No `--sha`: an evaluation runs no candidate code. No metric, no threshold and
    no baseline either -- all three live in the contract, and a caller that could
    pass a bar could pass its own bar.
    """
    spec_body = {
        "schema": 1,
        "kind": "evaluate",
        "args": {"run": args.run, "contract": resolve_contract(args.contract)},
    }
    for name, value in (("timeout_s", args.timeout), ("note", args.note)):
        if value is not None:
            spec_body[name] = value

    resp = call("submit", {"spec": spec_body})
    if not resp.get("ok"):
        die(resp.get("error", "submit refused"))
    run_id = resp["run_id"]
    print(run_id)
    if not args.wait:
        return
    while True:
        time.sleep(POLL_S)
        st = call("status", {"run_id": run_id})
        if not st.get("ok"):
            die(st.get("error", "status failed"))
        job = st["job"]
        if job["state"] in TERMINAL:
            pins = job.get("pins") or {}
            print(f"{job['state']} error_class={job['error_class']}",
                  file=sys.stderr)
            # THE VERDICT AND WHAT PRODUCED IT. A verdict with no contract hash
            # beside it is a number whose rule nobody can look up.
            for key in ("verdict", "contract_hash", "judged_run",
                        "request_hash", "baseline_hash", "predictions_sha256"):
                if pins.get(key):
                    print(f"{key}: {pins[key]}", file=sys.stderr)
            print_scoreboard(pins.get("scoreboard"))
            raise SystemExit(0 if job["state"] == "SUCCEEDED" else 1)


def print_scoreboard(text):
    """The metrics behind a verdict, one line each.

    A word is not a result. `no-go` at 6.7% against a 15% bar and `no-go` at
    14.9% against the same bar are the same word and different situations, and
    the difference is the whole content of an experiment. `verdict.json` has
    always held this, in the run's `out/` -- which the submitting identity
    cannot read.

    Unparseable is printed RAW rather than swallowed: the pin came from another
    service, and a summary that quietly renders as nothing is worse than one
    that renders badly.
    """
    if not text:
        return
    try:
        board = json.loads(text)
        metrics = board["metrics"]
    except (ValueError, KeyError, TypeError):
        print(f"scoreboard: {text}", file=sys.stderr)
        return
    print("scoreboard:", file=sys.stderr)
    for name, spec in sorted(metrics.items()):
        # `is True` / `is False`, never truthiness. `passed: "false"` and
        # `passed: 1` are both truthy in python, so a bare `if spec["passed"]`
        # printed PASS for a metric that had failed. `qfd` refuses a non-bool
        # now, and this stays strict anyway: this renders pins that may have been
        # written by an older build, and "??" is the honest answer to a field
        # that does not say.
        passed = spec.get("passed")
        mark = "PASS" if passed is True else "FAIL" if passed is False else "??"
        bits = [f"  {mark}  {name}"]
        if spec.get("bucket"):
            bits.append(f"[{spec['bucket']}]")
        for field in ("measured", "value", "baseline"):
            value = spec.get(field)
            if isinstance(value, (int, float)) and not isinstance(value, bool):
                bits.append(f"{field}={value:.4g}")
        # `bar` is an OBJECT: `{kind, value}` for a threshold, `{kind, low,
        # high}` for a band. Rendered as `bar=<kind>:<numbers>` so the rule and
        # the number it compares against stay together -- `bar=0.15` alone does
        # not say whether that is 15% better than baseline or an absolute 0.15.
        bar = spec.get("bar")
        if isinstance(bar, dict):
            numbers = [f"{bar[k]:.4g}" for k in ("value", "low", "high")
                       if isinstance(bar.get(k), (int, float))
                       and not isinstance(bar.get(k), bool)]
            label = bar.get("kind") or "bar"
            bits.append(f"bar={label}"
                        + (f":{'..'.join(numbers)}" if numbers else ""))
        print(" ".join(bits), file=sys.stderr)
    days = board.get("consistency") or {}
    if days.get("days_required") is not None:
        print(f"  days_passed={days.get('days_passed')}"
              f"/{days.get('days_required')} required", file=sys.stderr)


def cmd_status(args):
    show(call("status", {"run_id": args.run_id}), args.json)


def cmd_list(args):
    resp = call("list", {"state": args.state, "limit": args.limit})
    if not resp.get("ok"):
        die(resp.get("error", "list failed"))
    if args.json:
        print(json.dumps(resp, indent=2, sort_keys=True))
        return
    for job in resp["jobs"]:
        print(f"{job['run_id']:<52} {job['state']:<16} {job['lane']:<6}"
              f" {job['submitted_at']}")


def cmd_cancel(args):
    show(call("cancel", {"run_id": args.run_id}), args.json)


def cmd_verify_chain(args):
    resp = call("verify-chain")
    if not resp.get("ok"):
        die(resp.get("error", "verify failed"))
    print("chain_ok:", resp["chain_ok"])
    for problem in resp["problems"]:
        print(" ", problem)
    raise SystemExit(0 if resp["chain_ok"] else 1)


def cmd_trusted_paths(args):
    resp = call("trusted-paths")
    if not resp.get("ok"):
        die(resp.get("error", "trusted-paths failed"))
    if args.json:
        print(json.dumps(resp, indent=2, sort_keys=True))
        return
    print("trusted_dir:", resp["trusted_dir"])
    for entry in resp["paths"]:
        if "error" in entry:
            print(f"  {entry['name']:<26} ERROR {entry['error']}")
        else:
            print(f"  {entry['name']:<26} {entry['sha256'][:16]}"
                  f"  {entry['realpath']}")


def cmd_logs(args):
    # Read the file directly; the socket is control-only (D9).
    path = os.path.join(RUNS_DIR, args.run_id, "logs", args.stream + ".log")
    try:
        with open(path, "rb") as fh:
            sys.stdout.buffer.write(fh.read())
    except FileNotFoundError:
        die(f"no {args.stream} log at {path}")
    except OSError as e:
        # `os.path.exists` answers False for a path it cannot REACH, so the
        # previous version reported a missing log file for what was a permission
        # fault two directories up -- and sent the reader looking in the wrong
        # place entirely. Distinguish "not there" from "not allowed".
        die(f"cannot read {path}: {e}")


def cmd_force_release(args):
    if not args.i_have_verified_nothing_is_running:
        die("refusing without --i-have-verified-nothing-is-running")
    show(call("force-release",
              {"run_id": args.run_id,
               "i_have_verified_nothing_is_running": True},
              admin=True), args.json)


def _allow_json_after_the_subcommand(sub):
    """Accept `--json` on EITHER side of the subcommand.

    It used to be global only, so `qf status <run_id> --json` -- the order
    everyone types, and the order every state read in the NC suite used -- exited
    2 with "unrecognized arguments: --json". The suite discarded that stderr, so
    the read returned an empty string, and NC8's mutual-exclusion and
    memory-budget clauses passed having observed nothing at all.

    default=SUPPRESS is load-bearing rather than tidy: with store_true's normal
    default of False, a subparser flag OVERWRITES the namespace, so
    `qf --json status x` would come back with json=False.
    """
    for parser in sub.choices.values():
        parser.add_argument("--json", action="store_true",
                            default=argparse.SUPPRESS,
                            help="raw JSON output")


_HEX64_RE = re.compile(r"^[0-9a-f]{64}$")
_PREFIX_RE = re.compile(r"^[0-9a-f]{8,64}$")


def build_parser(admin_mode):
    p = argparse.ArgumentParser(
        prog="qfadmin" if admin_mode else "qf",
        description=("the dispatcher's admin client (admin socket)" if admin_mode
                     else "the dispatcher's client"))
    p.add_argument("--json", action="store_true", help="raw JSON output")
    sub = p.add_subparsers(dest="cmd", required=True)

    if admin_mode:
        fr = sub.add_parser("force-release",
                            help="release a CLEANUP_BLOCKED job's lock and"
                                 " reservation after verifying by hand")
        fr.add_argument("run_id")
        fr.add_argument("--i-have-verified-nothing-is-running",
                        action="store_true",
                        help="required; you are asserting you checked. If"
                             " Docker will not answer about a recorded"
                             " container, the FIRST call revokes the hold and"
                             " refuses: nothing further can start after that,"
                             " so re-check those containers and run the same"
                             " command again")
        fr.set_defaults(func=cmd_force_release)
        _allow_json_after_the_subcommand(sub)
        return p

    sub.add_parser("ping").set_defaults(func=cmd_ping)

    s = sub.add_parser("submit")
    s.add_argument("--kind", required=True, choices=("test", "selftest"))
    s.add_argument("--sha", required=True, help="full 40-hex commit id")
    s.add_argument("--path", action="append",
                   help="repeatable; relative test path or node id")
    s.add_argument("-k", help="pytest -k expression")
    s.add_argument("--flag", action="append", help="repeatable pytest flag")
    s.add_argument("--timeout", type=int)
    s.add_argument("--mem")
    s.add_argument("--cpus", type=float)
    s.add_argument("--note")
    s.add_argument("--wait", action="store_true",
                   help="poll to a terminal state and exit with the job's code")
    s.set_defaults(func=cmd_submit)

    ex = sub.add_parser("extract",
                        help="ask the trusted extractor for a frozen extract")
    ex.add_argument("--target", required=True,
                    choices=("wait_time", "run_duration"))
    ex.add_argument("--train-start", required=True, dest="train_start",
                    metavar="YYYY-MM-DDT00:00:00Z",
                    help="UTC day boundary; the window start")
    ex.add_argument("--as-of", required=True, dest="as_of",
                    metavar="YYYY-MM-DDT00:00:00Z",
                    help="UTC day boundary; must be past the settlement lag")
    ex.add_argument("--lookback-days", type=int, default=30,
                    dest="lookback_days",
                    help="reference-window floor for queue-context features")
    ex.add_argument("--generation", type=int,
                    help="bump to re-extract the same window deliberately;"
                         " a published extract is immutable")
    ex.add_argument("--note")
    ex.add_argument("--wait", action="store_true",
                    help="poll to a terminal state and print the extract's"
                         " identity")
    ex.set_defaults(func=cmd_extract)

    pr = sub.add_parser("probe",
                        help="run a research/experiments/ script against a"
                             " published extract")
    pr.add_argument("--sha", required=True, help="full 40-hex commit id")
    pr.add_argument("--path", required=True,
                    metavar="research/experiments/x.py",
                    help="the script to run; must be under research/experiments/")
    pr.add_argument("--extract", required=True, metavar="REQUEST_HASH",
                    help="an already-published extract, or any unique prefix of"
                         " one (8+ hex); see `qf extracts`")
    pr.add_argument("--baseline", metavar="BASELINE_HASH",
                    help="a promoted baseline to mount read-only at /baseline,"
                         " or any unique prefix of one (8+ hex); see"
                         " `qf baselines`. Omit it for a cohort that reads no"
                         " baseline")
    pr.add_argument("--mem", help="default 8g, which derives the heavy lane")
    pr.add_argument("--cpus", type=float)
    pr.add_argument("--timeout", type=int)
    pr.add_argument("--note")
    pr.add_argument("--wait", action="store_true")
    pr.set_defaults(func=cmd_probe)

    sub.add_parser("extracts",
                   help="list published extracts with hashes and watermarks"
                   ).set_defaults(func=cmd_extracts)

    sub.add_parser("baselines",
                   help="list promoted baselines with hashes and day coverage"
                   ).set_defaults(func=cmd_baselines)

    sub.add_parser("contracts",
                   help="list the evaluation contracts the trusted checkout"
                        " carries").set_defaults(func=cmd_contracts)

    ev = sub.add_parser("evaluate",
                        help="judge a finished probe by a trusted contract")
    ev.add_argument("--run", required=True, metavar="RUN_ID",
                    help="the probe whose predictions to judge")
    ev.add_argument("--contract", required=True, metavar="CONTRACT_HASH",
                    help="a contract in the trusted checkout, or any unique"
                         " prefix of one (8+ hex); see `qf contracts`")
    ev.add_argument("--timeout", type=int)
    ev.add_argument("--note")
    ev.add_argument("--wait", action="store_true")
    ev.set_defaults(func=cmd_evaluate)

    st = sub.add_parser("status")
    st.add_argument("run_id")
    st.set_defaults(func=cmd_status)

    ls = sub.add_parser("list")
    ls.add_argument("--state")
    ls.add_argument("--limit", type=int, default=20)
    ls.set_defaults(func=cmd_list)

    c = sub.add_parser("cancel")
    c.add_argument("run_id")
    c.set_defaults(func=cmd_cancel)

    sub.add_parser("verify-chain").set_defaults(func=cmd_verify_chain)
    sub.add_parser("trusted-paths").set_defaults(func=cmd_trusted_paths)

    lg = sub.add_parser("logs")
    lg.add_argument("run_id")
    lg.add_argument("--stream", default="stdout",
                    choices=("stdout", "stderr"))
    lg.set_defaults(func=cmd_logs)
    _allow_json_after_the_subcommand(sub)
    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    admin_mode = os.path.basename(sys.argv[0]) == "qfadmin"
    args = build_parser(admin_mode).parse_args(argv)
    args.func(args)
    return 0


if __name__ == "__main__":
    sys.exit(main())

[Unit]
Description=One turn of the queue-forecasting research loop
Documentation=file:///srv/queue-forecasting/tools/queue-forecasting/auto-research-loop-design.md
# The tick submits jobs over the client socket, so a tick that starts before the
# dispatcher is up would fail on its first `results.sh`.
After=qf-dispatch.service
Wants=qf-dispatch.service
# THE ALARM FOR A TICK THAT DIED BEFORE IT COULD PAUSE ITSELF. `tick.sh` has
# around twenty-five `die` sites and a `die` writes no `PAUSE` and files no
# issue: it exits non-zero and the timer tries again in an hour. A broken
# install -- an unreadable prompt file, a missing workspace, an unset HOME --
# therefore left the loop retrying hourly forever with NOTHING raising an alarm,
# which is the 2026-09-04 silence by a different route. systemd is the only
# party that sees the exit status of a unit nobody is watching.
#
# It files the same issue `pause-issue.sh open` files and writes the same
# `PAUSE`, so the release is the one a human already knows.
#
# IT MAY FIRE ON EVERY FAILED TICK, AND THAT IS FINE -- but not because of the
# exit code, and the earlier version of this comment claimed a guarantee the
# code does not provide. `OnFailure=` triggers on the unit entering FAILED, and
# `tick.sh` has `die` sites ABOVE its PAUSE check (tick.sh:202) -- workspace and
# HOME resolution, CTX creation -- which are precisely the broken-install faults
# this alarm exists for and which exit non-zero every hour with `PAUSE` already
# on disk. What keeps that to ONE issue rather than twenty-four a day is
# `pause-issue.sh`'s idempotency: the stamp is searched across `--state all` and
# `tick-failure-alarm.sh` never rewrites an existing `PAUSE`, so the stamp
# cannot change. The brake is what quietens the LOG; the stamp is what quietens
# the ALARM. See tick-failure-alarm.sh.
OnFailure=qf-tick-failure.service

[Service]
Type=oneshot
User=research
Group=research
# The identity that owns the experiments. `SupplementaryGroups` is not set here:
# the tick needs `qfclient` for the client socket, which `research`'s own group
# membership already provides (phase0-setup.sh, "Identity: one user, three
# groups"). Restating it here would be a second place to keep in step.

# A LOGIN SHELL, and this is load-bearing, not style. The research user's egress
# is nftables uid-scoped through tinyproxy and the proxy variables live in
# `~/.profile`, which a bare ExecStart does not read. Without them git and both
# agent CLIs bypass the proxy, nftables refuses, and the failure reads as a
# credential problem: "Failed to connect to github.com port 443 after 5 ms".
# README's "Proxy environment lives in ~/.profile, not ~/.bashrc" records the
# same trap for cron.
ExecStart=/bin/bash -lc '/srv/queue-forecasting/tools/queue-forecasting/host/research-loop/tick.sh'

# THE TICK BLOCKS ON A TRAINING RUN, by design: one action per tick, and
# `experiment.py run` waits for the probe and then the evaluation. Its own
# default timeout is 5400s per job, so a generous ceiling here plus a kill that
# is not instant. A tighter TimeoutStartSec would kill the loop mid-experiment
# and leave the training mutex held until the dispatcher's lease expired.
TimeoutStartSec=4h
KillSignal=SIGTERM
TimeoutStopSec=90

Environment=QF_REQUIRE_PREREG=1
Environment=QF_TICK_MAX_RUNS=4
Environment=QF_TICK_MAX_TICKS=12
# BOTH BRAKES, and neither is raised. 2026-09-04 auto-paused correctly on the
# first and mis-attributed nothing to the second because the second did not yet
# exist: a verifier outage counted as drift.
#
# THE COMMITTED VALUE STAYS 3. A `systemctl edit` drop-in raising it to 5 ran
# live for weeks -- unreviewed, invisible to `unit_matches`, which compares unit
# FILES, and found only while investigating that pause. It is NOT blessed by
# being written down here: every rejection it fired on was locally correct, so
# the drop-in is undocumented drift for a human to remove
# (`sudo systemctl revert qf-tick`), which `env_matches` in phase2-setup.sh now
# reports on every refresh.
Environment=QF_TICK_MAX_DISAGREE=3
Environment=QF_TICK_MAX_VERIFIER_FAILS=3
# Two rejection episodes retire a run (design section 1.3). Never 0: frontier.py
# refuses to build rather than treat 0 as "retire everything".
Environment=QF_FRONTIER_RETIRE_AFTER=2
# PINNED HERE, IN ROOT-OWNED CONFIGURATION, and never derived from the
# checkout's `git remote`: that checkout is research-writable, so deriving the
# repository from it would let the identity being watched choose who gets told.
Environment=QF_PAUSE_ISSUE_REPO=lotas/qf-research
# THE TOKEN PATH IS UNIT CONFIGURATION TOO, even though `pause-issue.sh`
# defaults it to `$HOME/.config/qf/pause-issue-token`: the default is INVISIBLE.
# A deploy that puts the token elsewhere fails at the one moment the alarm is
# needed, and the failure reads as `PAUSE exists; stopping` -- the 2026-09-04
# silence exactly. Pinned so the path is reviewable in one place, and so an
# unset HOME cannot root it at `/`.
Environment=QF_PAUSE_TOKEN_FILE=/home/research/.config/qf/pause-issue-token

NoNewPrivileges=yes
ProtectSystem=strict
PrivateDevices=yes
# `ProtectHome` MUST NOT be set: the workspace, the journal, the agent CLIs'
# credentials and `~/.profile` all live in the research user's home, and this
# unit is the one thing that legitimately reads all four.
ReadWritePaths=/home/research
# /tmp, AND THIS IS WHAT BROKE THE LOOP ON 2026-09-02. `ProtectSystem=strict`
# mounts the WHOLE hierarchy read-only bar /dev, /proc and /sys -- /tmp is not
# exempt, and with `PrivateTmp=no` it is the host's real, read-only /tmp. The
# `claude` CLI puts its per-workspace scratch in `os.tmpdir()/claude-<uid>/<cwd
# slug>`, so every Bash call the leader made returned, before running anything:
#
#   EROFS: read-only file system, mkdir '/tmp/claude-1001/-home-research-qf-research'
#
# It was hidden for a day because a hand-run `install.sh once` is NOT sandboxed,
# so it created that directory and the sandboxed ticks quietly reused it; when
# /tmp was cleaned the loop lost its shell and five ticks in a row escalated with
# no evidence they could possibly have pasted.
#
# /tmp AND NOT A PRIVATE ONE: `PrivateTmp=yes` would isolate this unit from the
# /tmp the hand-run and the dispatcher see, which is the coordination the comment
# below is about. And this grants nothing: /tmp is world-writable with the sticky
# bit, so any login shell as `research` already has exactly this.
ReadWritePaths=/tmp
# PrivateTmp=no, deliberately. The dispatcher's lock lives at
# /var/lib/qf-locks and the README's "The lock, and PrivateTmp=no" records why a
# private namespace here breaks coordination between units.
PrivateTmp=no

[Install]
WantedBy=multi-user.target
